# Copie para .env e preencha localmente. Nunca versione o arquivo .env.
TIMEZONE=America/Sao_Paulo
SCHEDULE_TIMES=01:00,04:00,07:00,10:00,13:00,16:00,19:00,22:00

# Sistema web
SYSTEM_URL=https://substitua-pela-url-do-sistema
SYSTEM_WAIT_UNTIL=domcontentloaded
PAGE_READY_SELECTOR=
NETWORK_IDLE_TIMEOUT_MS=45000
PAGE_SETTLE_WAIT_MS=60000
SCREENSHOT_WIDTH=1920
SCREENSHOT_HEIGHT=1080
SCREENSHOT_CROP_X=360
SCREENSHOT_CROP_Y=116

# Login headless opcional para formulário simples. O seletor de confirmação deve
# existir apenas após a autenticação. Não automatiza nem contorna MFA, SSO, CAPTCHA
# ou bloqueios corporativos.
LOGIN_URL=
USERNAME=
PASSWORD=
USERNAME_SELECTOR=
PASSWORD_SELECTOR=
LOGIN_SUBMIT_SELECTOR=
POST_LOGIN_READY_SELECTOR=

# WhatsApp
WHATSAPP_GROUP_ID=
API_TOKEN=
WHATSAPP_MESSAGE=Checkpoint - ELSYS ONE [NETYLINK]\n\n⏱️ Período atual do monitoramento.\n\nEquipe BOC\nCore | Technologies
# Opção legada, não usada pelo envio atual via API:
WHATSAPP_AUTH_DIR=./data/whatsapp-auth

# Operação
HEADLESS=true
NAVIGATION_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=15000
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=3000
SCREENSHOT_DIR=./data/screenshots
STATE_FILE=./data/state.json
LOG_LEVEL=info
