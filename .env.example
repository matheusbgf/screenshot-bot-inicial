# Copie para .env e preencha localmente. Nunca versione o arquivo .env.
TIMEZONE=America/Sao_Paulo
INTERVAL_MINUTES=60
RUN_ON_START=true

# Sistema web
SYSTEM_URL=https://substitua-pela-url-do-sistema
SYSTEM_WAIT_UNTIL=domcontentloaded
PAGE_READY_SELECTOR=
SCREENSHOT_SELECTOR=
SCREENSHOT_FULL_PAGE=false

# Login opcional por formulário. Se houver SSO/MFA, configure a sessão manualmente
# ou adapte login.js; não tente contornar CAPTCHA ou controles corporativos.
LOGIN_URL=
USERNAME=
PASSWORD=
USERNAME_SELECTOR=
PASSWORD_SELECTOR=
LOGIN_SUBMIT_SELECTOR=
POST_LOGIN_READY_SELECTOR=

# WhatsApp
WHATSAPP_GROUP_ID=
WHATSAPP_MESSAGE=Segue o relatório atualizado:
WHATSAPP_AUTH_DIR=./data/whatsapp-auth

# Operação
HEADLESS=true
NAVIGATION_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=15000
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=3000
SCREENSHOT_DIR=./data/screenshots
STATE_FILE=./data/state.json
LOG_LEVEL=info
